    { "from": "forms", "to": "notify", "label": "ops_complaint" }
  ],
  "cards": [
    { "dot": "emerald", "title": "One form", "items": ["Published customer-complaints form", "Inbox is Planner Forms", "Thumbs up opens Google"] },
