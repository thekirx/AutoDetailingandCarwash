{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/packages", "destination": "/services", "permanent": true },
    { "source": "/booking", "destination": "/book", "permanent": true },
    { "source": "/services/detailing", "destination": "/services/wash-detailing", "permanent": true },
    { "source": "/services/wash", "destination": "/services/wash-detailing", "permanent": true },
    { "source": "/services/paint-protection-film", "destination": "/services/ppf", "permanent": true },
    { "source": "/services/ceramic-coating", "destination": "/services/ceramic", "permanent": true },
    { "source": "/services/window-tint", "destination": "/services/tint", "permanent": true },
    { "source": "/locations", "destination": "/branches", "permanent": true },
    { "source": "/branches/molino", "destination": "/branches/bacoor", "permanent": true },
    { "source": "/branches/alangilan", "destination": "/branches/batangas", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/points-shop", "destination": "/api/bookings?operation=points-shop" },
    { "source": "/api/booking-status", "destination": "/api/bookings?operation=booking-status" },
    { "source": "/api/maintenance-schedules", "destination": "/api/bookings?operation=maintenance-schedules" },
    { "source": "/api/busybee", "destination": "/api/notifications?operation=busybee" },
    { "source": "/api/customer-auth-lookup", "destination": "/api/customer?operation=customer-auth-lookup" },
    { "source": "/api/customer-history", "destination": "/api/customer?operation=customer-history" },
    { "source": "/api/customer-portal", "destination": "/api/customer?operation=customer-portal" },
    { "source": "/api/customer-signup", "destination": "/api/customer?operation=customer-signup" },
    { "source": "/api/referral", "destination": "/api/customer?operation=referral" },
    { "source": "/api/vehicle-transfer", "destination": "/api/customer?operation=vehicle-transfer" },
    { "source": "/api/data-center", "destination": "/api/data-center?operation=data-center" },
    { "source": "/api/demo-login", "destination": "/api/demo-login?operation=demo-login" },
    { "source": "/api/lifecycle-sms", "destination": "/api/notifications?operation=lifecycle-sms" },
    { "source": "/api/notify-booking", "destination": "/api/notifications?operation=notify-booking" },
    { "source": "/api/notify-ops-form", "destination": "/api/notifications?operation=notify-ops-form" },
    { "source": "/api/notify-planner", "destination": "/api/notifications?operation=notify-planner" },
    { "source": "/api/notify-pos", "destination": "/api/notifications?operation=notify-pos" },
    { "source": "/api/pos-announce", "destination": "/api/notifications?operation=pos-announce" },
    { "source": "/api/notify-ops-event", "destination": "/api/notifications?operation=notify-ops-event" },
    { "source": "/api/notification-settings", "destination": "/api/notifications?operation=notification-settings" },
    { "source": "/api/notification-config", "destination": "/api/notifications?operation=notification-config" },
    { "source": "/api/notification-broadcast", "destination": "/api/notifications?operation=notification-broadcast" },
    { "source": "/api/notification-broadcast-kinds", "destination": "/api/notifications?operation=notification-broadcast-kinds" },
    { "source": "/api/notification-templates", "destination": "/api/notifications?operation=notification-templates" },
    { "source": "/api/birthday-greetings", "destination": "/api/notifications?operation=birthday-greetings" },
    { "source": "/api/plate-lookup", "destination": "/api/bookings?operation=plate-lookup" },
    { "source": "/api/public-inquiry", "destination": "/api/customer?operation=public-inquiry" },
    { "source": "/api/provision-customer", "destination": "/api/customer?operation=provision-customer" },
    { "source": "/api/provision-staff", "destination": "/api/staff?operation=provision-staff" },
    { "source": "/api/public-book", "destination": "/api/bookings?operation=public-book" },
    { "source": "/api/referral-program", "destination": "/api/bookings?operation=referral-program" },
    { "source": "/api/referral-staff", "destination": "/api/bookings?operation=referral-staff" },
    { "source": "/api/accessory-points", "destination": "/api/bookings?operation=accessory-points" },
    { "source": "/api/push-subscribe", "destination": "/api/notifications?operation=push-subscribe" },
    { "source": "/api/send-finance-quote", "destination": "/api/finance?operation=send-finance-quote" },
    { "source": "/api/send-push", "destination": "/api/notifications?operation=send-push" },
    { "source": "/api/update-staff", "destination": "/api/staff?operation=update-staff" },
    { "source": "/sitemap.xml", "destination": "/api/seo?operation=sitemap" },
    { "source": "/rss.xml", "destination": "/api/seo?operation=rss" },
    { "source": "/feed.xml", "destination": "/api/seo?operation=rss" },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-Extended|Bingbot|bingbot|Applebot|OAI-SearchBot|ChatGPT-User|GPTBot|Claude-SearchBot|PerplexityBot|Perplexity-User|DuckAssistBot|SemrushBot|SiteAuditBot|AhrefsBot|meta-externalagent|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Viber|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?operation=home-meta"
    },
    {
      "source": "/branches",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-Extended|Bingbot|bingbot|Applebot|OAI-SearchBot|ChatGPT-User|GPTBot|Claude-SearchBot|PerplexityBot|Perplexity-User|DuckAssistBot|SemrushBot|SiteAuditBot|AhrefsBot|meta-externalagent|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Viber|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?operation=branches-meta"
    },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-Extended|Bingbot|bingbot|Applebot|OAI-SearchBot|ChatGPT-User|GPTBot|Claude-SearchBot|PerplexityBot|Perplexity-User|DuckAssistBot|SemrushBot|SiteAuditBot|AhrefsBot|meta-externalagent|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Viber|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?operation=blog-meta&slug=:slug"
    },
    {
      "source": "/events/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-Extended|Bingbot|bingbot|Applebot|OAI-SearchBot|ChatGPT-User|GPTBot|Claude-SearchBot|PerplexityBot|Perplexity-User|DuckAssistBot|SemrushBot|SiteAuditBot|AhrefsBot|meta-externalagent|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Viber|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?operation=event-meta&slug=:slug"
    },
    {
      "source": "/branches/:citySlug/:serviceSlug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-Extended|Bingbot|bingbot|Applebot|OAI-SearchBot|ChatGPT-User|GPTBot|Claude-SearchBot|PerplexityBot|Perplexity-User|DuckAssistBot|SemrushBot|SiteAuditBot|AhrefsBot|meta-externalagent|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Viber|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?operation=branch-service-meta&citySlug=:citySlug&serviceSlug=:serviceSlug"
    },
    {
      "source": "/branches/:citySlug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-Extended|Bingbot|bingbot|Applebot|OAI-SearchBot|ChatGPT-User|GPTBot|Claude-SearchBot|PerplexityBot|Perplexity-User|DuckAssistBot|SemrushBot|SiteAuditBot|AhrefsBot|meta-externalagent|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Viber|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?operation=branch-meta&citySlug=:citySlug"
    },
    {
      "source": "/services/:serviceSlug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-Extended|Bingbot|bingbot|Applebot|OAI-SearchBot|ChatGPT-User|GPTBot|Claude-SearchBot|PerplexityBot|Perplexity-User|DuckAssistBot|SemrushBot|SiteAuditBot|AhrefsBot|meta-externalagent|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Viber|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?operation=service-meta&serviceSlug=:serviceSlug"
    },
    {
      "source": "/services",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-Extended|Bingbot|bingbot|Applebot|OAI-SearchBot|ChatGPT-User|GPTBot|Claude-SearchBot|PerplexityBot|Perplexity-User|DuckAssistBot|SemrushBot|SiteAuditBot|AhrefsBot|meta-externalagent|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Viber|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?operation=service-meta"
    },
    { "source": "/((?!api/|assets/).*)", "destination": "/index" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" },
        { "key": "Content-Signal", "value": "search=yes, ai-input=yes" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' blob: https://*.supabase.co wss://*.supabase.co https://*.busybee.ph https://app.brandtxt.io https://api.open-meteo.com https://nominatim.openstreetmap.org https://fcm.googleapis.com https://*.googleapis.com https://updates.push.services.mozilla.com https://*.push.services.mozilla.com https://web.push.apple.com https://*.push.apple.com https://*.notify.windows.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/(api|operations|app|account)/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(operations|app|account)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/notifications?operation=points-shop-expiry",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/notifications?operation=birthday-greetings",
      "schedule": "5 16 * * *"
    },
    {
      "path": "/api/notifications?operation=booking-reminders",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/notifications?operation=maintenance-reminders",
      "schedule": "15 0 * * *"
    }
  ]
}
