    { "id": "review", "label": "Branch", "fromCol": 4, "toCol": 5 }
  ],
  "mainPath": ["visit", "thumbs_down", "payload", "rpc", "forms", "notify"],
  "nodes": [
    { "id": "visit", "lane": "customer", "col": 0, "type": "frontend", "label": "Last visit", "sublabel": "own booking" },
    { "id": "thumbs_down", "lane": "customer", "col": 1, "type": "frontend", "label": "Thumbs down", "sublabel": "what happened" },
