{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/booking-status", "destination": "/api/bookings?operation=booking-status" },
    { "source": "/api/busybee", "destination": "/api/notifications?operation=busybee" },
    { "source": "/api/customer-auth-lookup", "destination": "/api/customer?operation=customer-auth-lookup" },
    { "source": "/api/customer-history", "destination": "/api/customer?operation=customer-history" },
    { "source": "/api/customer-portal", "destination": "/api/customer?operation=customer-portal" },
    { "source": "/api/customer-signup", "destination": "/api/customer?operation=customer-signup" },
    { "source": "/api/data-center", "destination": "/api/data-center?operation=data-center" },
    { "source": "/api/lifecycle-sms", "destination": "/api/notifications?operation=lifecycle-sms" },
    { "source": "/api/notify-booking", "destination": "/api/notifications?operation=notify-booking" },
    { "source": "/api/notify-ops-form", "destination": "/api/notifications?operation=notify-ops-form" },
    { "source": "/api/notification-settings", "destination": "/api/notifications?operation=notification-settings" },
    { "source": "/api/notification-broadcast", "destination": "/api/notifications?operation=notification-broadcast" },
    { "source": "/api/notification-broadcast-kinds", "destination": "/api/notifications?operation=notification-broadcast-kinds" },
    { "source": "/api/notification-templates", "destination": "/api/notifications?operation=notification-templates" },
    { "source": "/api/birthday-greetings", "destination": "/api/notifications?operation=birthday-greetings" },
    { "source": "/api/plate-lookup", "destination": "/api/bookings?operation=plate-lookup" },
    { "source": "/api/provision-customer", "destination": "/api/customer?operation=provision-customer" },
    { "source": "/api/provision-staff", "destination": "/api/staff?operation=provision-staff" },
    { "source": "/api/public-book", "destination": "/api/bookings?operation=public-book" },
    { "source": "/api/push-subscribe", "destination": "/api/notifications?operation=push-subscribe" },
    { "source": "/api/send-finance-quote", "destination": "/api/finance?operation=send-finance-quote" },
    { "source": "/api/send-push", "destination": "/api/notifications?operation=send-push" },
    { "source": "/api/update-staff", "destination": "/api/staff?operation=update-staff" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' blob: https://*.supabase.co wss://*.supabase.co https://*.busybee.ph https://app.brandtxt.io https://fcm.googleapis.com https://*.googleapis.com https://updates.push.services.mozilla.com https://*.push.services.mozilla.com https://web.push.apple.com https://*.push.apple.com https://*.notify.windows.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/notifications?operation=birthday-greetings",
      "schedule": "5 16 * * *"
    }
  ]
}
