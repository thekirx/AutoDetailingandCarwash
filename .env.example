VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Show demo account chips on Login (also auto-on for *.vercel.app hosts). Set true on Vercel for custom domains.
VITE_ENABLE_DEMO_LOGIN=true

# Server-only (never VITE_*). Copy from Dashboard → Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# BusyBee BrandTxT SMS (server-only). Base URL from your BusyBee portal API manual.
BUSYBEE_API_BASE_URL=https://app.brandtxt.io
BUSYBEE_API_KEY=
BUSYBEE_CLIENT_ID=
BUSYBEE_SENDER_ID=HAKUM

# Web Push VAPID (npx web-push generate-vapid-keys). Public may be VITE_*; private server-only.
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@hakumautocare.com

# Resend (finance quotations). Server-only. Without key, quote API returns preview-only.
RESEND_API_KEY=
RESEND_FROM=Hakum Auto Care <onboarding@resend.dev>
